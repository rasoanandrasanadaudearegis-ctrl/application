# Copie ce fichier en ".env" et adapte les valeurs.
PORT=8040
DATABASE_URL=postgresql://aro_user:MotDePasseFort@127.0.0.1:5432/aro_rcc
# Chaine longue et aleatoire (ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=remplace-moi-par-une-longue-chaine-aleatoire
DB_TIMEZONE=Indian/Antananarivo
SEUIL_GROS_DEBITEUR=500000
AGENCE=FIANARANTSOA
UPLOAD_MAX_MB=200
# true si le site est servi en HTTPS (cookie "secure") ; derriere nginx/Apache : TRUST_PROXY=1
COOKIE_SECURE=false
TRUST_PROXY=0
# Dossier du front compile (npm run build) servi sous /aro-rcc-front/ (laisser vide pour ne pas le servir)
FRONT_DIST=../app_rcc/dist
